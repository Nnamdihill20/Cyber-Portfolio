{
  "name": "@sentinel-map/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "seed:police": "ts-node seed/import-osm-police.ts",
    "seed:facilities": "ts-node seed/import-facilities-csv.ts",
    "seed:facilities:sample": "ts-node seed/import-facilities-csv.ts --type ICE_FIELD_OFFICE --file seed/data/ice_field_offices.sample.csv && ts-node seed/import-facilities-csv.ts --type IMMIGRATION_COURT --file seed/data/eoir_courts.sample.csv && ts-node seed/import-facilities-csv.ts --type ICE_DETENTION_FACILITY --file seed/data/detention_facilities.sample.csv",
    "seed:cameras": "ts-node seed/import-alpr-cameras-csv.ts",
    "seed:legal-aid": "ts-node seed/import-legal-aid-csv.ts",
    "seed:legal-aid:sample": "ts-node seed/import-legal-aid-csv.ts --file seed/data/legal_aid.sample.csv",
    "seed:kyr": "ts-node seed/seed-know-your-rights.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "prisma": "^5.19.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
