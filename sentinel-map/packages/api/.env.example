DATABASE_URL="postgresql://sentinel:sentinel@localhost:5432/sentinel_map?schema=public"
PORT=4000

# Salt used to hash reporter IP+UA for rate limiting/corroboration.
# Change this in every real deployment - never commit the real value.
REPORTER_HASH_SALT="change-me-dev-only"

# How long an activity report stays visible before it auto-expires (minutes).
REPORT_TTL_MINUTES=180

# Signs admin session cookies (see src/lib/adminAuth.ts). A guessable value
# here is a full admin-auth bypass, unlike REPORTER_HASH_SALT above - the
# app refuses to start with this default value when NODE_ENV=production.
# Generate a real one with: openssl rand -base64 48
ADMIN_JWT_SECRET="dev-only-change-me"

# A report gets excluded from public results once it collects this many
# flags (see routes/reports.ts, routes/adminReports.ts).
REPORT_FLAG_THRESHOLD=3
